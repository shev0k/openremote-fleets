# Supported values: openRemote, mock
VITE_DATA_MODE=openRemote
# Leave these blank for local `npm run dev`; the Vite dev server proxies `/api`, `/auth`,
# and `/websocket` to the Docker-backed manager at `https://localhost`.
VITE_OR_MANAGER_URL=
VITE_OR_KEYCLOAK_URL=
# Set direct URLs only when intentionally bypassing the local proxy:
# VITE_OR_MANAGER_URL=https://localhost
# VITE_OR_KEYCLOAK_URL=https://localhost/auth
VITE_OR_REALM=master
VITE_OR_CLIENT_ID=openremote

# Optional Maps Embed API key for the Live Fleet Street View iframe.
# Keep real values in ignored local env files or deployment secrets.
# Restrict the key to Maps Embed API and allowed HTTP referrers.
VITE_GOOGLE_MAPS_EMBED_API_KEY=
